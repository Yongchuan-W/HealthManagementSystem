# 健康管理系统 环境变量模板
# 复制为 ai_local.env 或写入 systemd EnvironmentFile，按需填写
# 注意：真实密钥只放服务器，不要提交到代码仓库

# ---------- 服务 ----------
# 监听端口（不填则从 8000 起自动找空闲端口）
HM_PORT=8000
# 监听地址：服务器建议 127.0.0.1，配合反向代理/隧道
HM_BIND=127.0.0.1
# 服务器部署时设为 1，禁止自动打开浏览器
HM_NO_BROWSER=1
# 对外访问地址，用于 Cookie Secure 判定与日志
HM_PUBLIC_URL=https://your-domain.example
# 强制给 Cookie 加 Secure（HTTPS 环境可设 1）
HM_COOKIE_SECURE=0

# ---------- 本地 HTTPS（可选，二选一：要么用反向代理终止 TLS） ----------
HM_TLS_CERT=
HM_TLS_KEY=

# ---------- AI 模型（OpenAI 兼容接口） ----------
HM_AI_API_KEY=
HM_AI_API_BASE=https://api.deepseek.com/v1
HM_AI_MODEL=deepseek-flash

# ---------- 语音识别（可选） ----------
HM_ASR_APPKEY=
HM_ASR_AK_ID=
HM_ASR_AK_SECRET=
HM_ASR_REGION=cn-shanghai

# ---------- 邮件（找回密码，可选） ----------
HM_MAIL_HOST=smtp.qq.com
HM_MAIL_PORT=465
HM_MAIL_USER=
HM_MAIL_PASS=
HM_MAIL_FROM=

# ---------- 指定账号（可选，格式 账号:密码,账号:密码） ----------
# 这里配置的账号会被创建/同步，并标记为管理员
HM_ALLOWED_USERS=
